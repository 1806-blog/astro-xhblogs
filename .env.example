# Notion 集成（由 @elog/cli 读取，见 elog.posts.cjs / elog.chatters.cjs）
#
# 数据库里需要一列 type（select），选项「文章」「杂谈」——
# 两个配置文件靠它分流：文章进 src/posts，杂谈进 src/chatters。
#
# 1) 建 Integration：https://www.notion.so/my-integrations → New integration
#    复制 Internal Integration Secret
NOTION_TOKEN=

# 2) 数据库 ID：Notion 数据库页面 URL 里那串 32 位十六进制
#    https://www.notion.so/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=yyyy
NOTION_DATABASE_ID=

# ⚠️ 别忘了：在 Notion 里打开该数据库 → 右上角 ··· → 连接 → 添加你的 Integration
#    漏了这步会报 404 / Could not find database

# ---------------------------------------------------------------------------
# Memos 集成（由 scripts/memos-sync.mjs 读取，负责「说说」）
# ---------------------------------------------------------------------------

# Memos 实例地址（Cloudflare Workers 版的地址，如 https://memos.xxx.workers.dev）
MEMOS_BASE_URL=

# Memos → 设置 → 访问令牌，生成一个
MEMOS_TOKEN=

# 可选：设成 true 就连 PRIVATE 的说说一起发（默认只发 PUBLIC）
# MEMOS_INCLUDE_PRIVATE=true

# 网易云曲库：歌曲列表存在 src/data/neteaseTracks.json（线上不碰账号凭证）。
# 歌单变动后，本地带 Cookie 跑一次即可刷新：
#   NETEASE_COOKIE='<浏览器 Cookie>' node scripts/fetch-netease-tracks.mjs
# ⚠️ Cookie 只在本地这一次使用，不写进 .env、不进仓库、不部署。

# 图床（有默认值，一般不用填）
# STORAGE_API=https://storage.nightcord.de5.net
# STORAGE_PUBLIC=https://r2.nightcord.de5.net

# ---------------------------------------------------------------------------
# 部署到 Vercel 时：上面这些变量不要写进 .env（.env 不入库）
#   - Notion 的两个 → Vercel → Settings → Environment Variables
#   - Memos 的两个 → GitHub 仓库 → Settings → Secrets and variables → Actions
# 并把 Vercel 的 Build Command 改成：npm run build:notion
# ---------------------------------------------------------------------------
