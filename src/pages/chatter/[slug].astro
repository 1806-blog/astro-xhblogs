---
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';

import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkGfm from 'remark-gfm';
import remarkMath from 'remark-math';
import remarkRehype from 'remark-rehype';
import rehypeHighlight from 'rehype-highlight';
import rehypeKatex from 'rehype-katex';
import rehypeStringify from 'rehype-stringify';

import 'highlight.js/styles/atom-one-dark.css';
import '../../styles/article.css';

import Layout from '../../layouts/Layout.astro';
import ChatterDetailPage from '../../components/pages/ChatterDetailPage';
import { siteConfig } from '../../siteConfig';

const dir = path.join(process.cwd(), 'src', 'chatters');

export function getStaticPaths() {
  const d = path.join(process.cwd(), 'src', 'chatters');
  if (!fs.existsSync(d)) return [];
  return fs
    .readdirSync(d)
    .filter((name) => name.endsWith('.md'))
    .map((name) => ({ params: { slug: name.replace(/\.md$/, '') } }));
}

const { slug } = Astro.params as { slug: string };
const { data, content: source } = matter(fs.readFileSync(path.join(dir, `${slug}.md`), 'utf8'));

let content = source;
content = content.replace(/\r\n/g, '\n');
content = content.replace(/[\u200B-\u200D\uFEFF]/g, '');
content = content.replace(/^[ \t]+$/gm, '');
content = content.replace(/^(\s*\d+)\.([^ \n])/gm, '$1. $2');

const blocks = content.split(/(```[\s\S]*?```|~~~[\s\S]*?~~~)/g);
content = blocks
  .map((block, index) => {
    if (index % 2 === 1) {
      if (/^```[ \t]*(\n|$)/.test(block)) {
        return block.replace(/^```[ \t]*/, '```cpp');
      }
      return block;
    }
    return block.replace(/\n{3,}/g, (match) => {
      const brCount = match.length - 2;
      return '\n\n' + '<br>'.repeat(brCount) + '\n\n';
    });
  })
  .join('');

const processed = await unified()
  .use(remarkParse)
  .use(remarkGfm)
  .use(remarkMath)
  .use(remarkRehype, { allowDangerousHtml: true })
  // @ts-ignore
  .use(rehypeHighlight, {
    detect: true,
    ignoreMissing: true,
    subset: [
      'cpp',
      'c',
      'python',
      'java',
      'javascript',
      'typescript',
      'go',
      'rust',
      'bash',
      'json',
      'html',
      'css',
      'sql',
      'xml',
    ],
  })
  .use(rehypeKatex)
  .use(rehypeStringify, { allowDangerousHtml: true })
  .process(content);

const recentChatters = fs
  .readdirSync(dir)
  .filter((f) => f.endsWith('.md'))
  .map((f) => {
    const s = f.replace(/\.md$/, '');
    const { data: d } = matter(fs.readFileSync(path.join(dir, f), 'utf8'));
    return { slug: s, title: (d.title as string) || '碎片记录', date: (d.date as string) || '1970-01-01' };
  })
  .filter((p) => p.slug !== slug)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const title = (data.title as string) || '碎片记录';
---

<Layout title={title}>
  <ChatterDetailPage
    client:load
    title={title}
    date={(data.date as string) || ''}
    mood={(data.mood as string) || ''}
    tags={data.tags && Array.isArray(data.tags) ? (data.tags as string[]) : []}
    cover={(data.cover as string) || siteConfig.defaultPostCover}
    contentHtml={processed.toString()}
    recentChatters={recentChatters}
  />
</Layout>
